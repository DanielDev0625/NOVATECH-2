# Copia este archivo a ".env" para correr en local. En Vercel, estas mismas variables
# se cargan en Project Settings -> Environment Variables.

# Cadena de conexión de Neon (Connect -> copiar "Pooled connection").
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Clave larga y aleatoria para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Opcionales (valores por defecto entre paréntesis)
# FACTOR_EMISION_KWH=0.126
# FACTOR_EMISION_KM=0.25
# UTC_OFFSET_HORAS=-5
